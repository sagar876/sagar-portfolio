# Copy to .env.local for local development and set the same variables in your
# hosting provider. Never commit real values. None of these use the
# NEXT_PUBLIC_ prefix, so none of them reach browser code.

# Public URL of the deployed site. Used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (Resend) ---------------------------------------------------
# API key from https://resend.com/api-keys (needs "sending access" only).
RESEND_API_KEY=re_your_api_key_here

# Where contact messages are delivered. PLACEHOLDER — replace with your address.
CONTACT_TO_EMAIL=you@example.com

# Sender shown on notifications. Must use a domain verified in Resend.
# For local testing without a domain, Resend's sandbox sender works:
#   CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# (the sandbox only delivers to the email address of your Resend account).
CONTACT_FROM_EMAIL="Portfolio <contact@your-domain.example>"

# Optional rate limits (defaults shown). Limits are kept in memory, so they
# apply per server instance; see src/lib/contact/rate-limit.ts.
# CONTACT_RATE_LIMIT_PER_IP=5      # messages per IP per 10 minutes
# CONTACT_RATE_LIMIT_GLOBAL=30     # messages per hour across all visitors
